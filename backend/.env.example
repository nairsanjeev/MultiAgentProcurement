# Azure OpenAI Configuration
# For AzureOpenAIChatClient (used in foundation patterns)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Microsoft Foundry (Azure AI) Configuration
# For AzureAIAgentClient (used in multi-agent workflows)
FOUNDRY_PROJECT_ENDPOINT=https://your-project.cognitiveservices.azure.com/
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o

# Alternative: Use Azure DefaultAzureCredential for authentication
# Set this to "true" to use managed identity/Azure CLI auth instead of API keys
USE_AZURE_CREDENTIAL=false

# Application Configuration
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
